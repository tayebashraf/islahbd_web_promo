[{"n":1,"a":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","t":"আপনার কাছে আচ্ছন্নকারী কেয়ামতের বৃত্তান্ত পৌঁছেছে কি?","p":592,"j":30,"h":597},{"n":2,"a":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","t":"অনেক মুখমন্ডল সেদিন হবে লাঞ্ছিত,","p":592,"j":30,"h":597},{"n":3,"a":"عَامِلَةٌۭ نَّاصِبَةٌۭ","t":"ক্লিষ্ট, ক্লান্ত।","p":592,"j":30,"h":597},{"n":4,"a":"تَصْلَىٰ نَارًا حَامِيَةًۭ","t":"তারা জ্বলন্ত আগুনে পতিত হবে।","p":592,"j":30,"h":597},{"n":5,"a":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","t":"তাদেরকে ফুটন্ত নহর থেকে পান করানো হবে।","p":592,"j":30,"h":597},{"n":6,"a":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","t":"কন্টকপূর্ণ ঝাড় ব্যতীত তাদের জন্যে কোন খাদ্য নেই।","p":592,"j":30,"h":597},{"n":7,"a":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","t":"এটা তাদেরকে পুষ্ট করবে না এবং ক্ষুধায়ও উপকার করবে না।","p":592,"j":30,"h":597},{"n":8,"a":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","t":"অনেক মুখমন্ডল সেদিন হবে, সজীব,","p":592,"j":30,"h":598},{"n":9,"a":"لِّسَعْيِهَا رَاضِيَةٌۭ","t":"তাদের কর্মের কারণে সন্তুষ্ট।","p":592,"j":30,"h":598},{"n":10,"a":"فِى جَنَّةٍ عَالِيَةٍۢ","t":"তারা থাকবে, সুউচ্চ জান্নাতে।","p":592,"j":30,"h":598},{"n":11,"a":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","t":"তথায় শুনবে না কোন অসার কথাবার্তা।","p":592,"j":30,"h":598},{"n":12,"a":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","t":"তথায় থাকবে প্রবাহিত ঝরণা।","p":592,"j":30,"h":598},{"n":13,"a":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","t":"তথায় থাকবে উন্নত সুসজ্জিত আসন।","p":592,"j":30,"h":598},{"n":14,"a":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","t":"এবং সংরক্ষিত পানপাত্র","p":592,"j":30,"h":598},{"n":15,"a":"وَنَمَارِقُ مَصْفُوفَةٌۭ","t":"এবং সারি সারি গালিচা","p":592,"j":30,"h":598},{"n":16,"a":"وَزَرَابِىُّ مَبْثُوثَةٌ","t":"এবং বিস্তৃত বিছানো কার্পেট।","p":592,"j":30,"h":598},{"n":17,"a":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","t":"তারা কি উষ্ট্রের প্রতি লক্ষ্য করে না যে, তা কিভাবে সৃষ্টি করা হয়েছে?","p":592,"j":30,"h":598},{"n":18,"a":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","t":"এবং আকাশের প্রতি লক্ষ্য করে না যে, তা কিভা