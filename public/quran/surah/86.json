[{"n":1,"a":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","t":"শপথ আকাশের এবং রাত্রিতে আগমনকারীর।","p":591,"j":30,"h":596},{"n":2,"a":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","t":"আপনি জানেন, যে রাত্রিতে আসে সেটা কি?","p":591,"j":30,"h":596},{"n":3,"a":"ٱلنَّجْمُ ٱلثَّاقِبُ","t":"সেটা এক উজ্জ্বল নক্ষত্র।","p":591,"j":30,"h":596},{"n":4,"a":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","t":"প্রত্যেকের উপর একজন তত্ত্বাবধায়ক রয়েছে।","p":591,"j":30,"h":596},{"n":5,"a":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","t":"অতএব, মানুষের দেখা উচিত কি বস্তু থেকে সে সৃজিত হয়েছে।","p":591,"j":30,"h":596},{"n":6,"a":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","t":"সে সৃজিত হয়েছে সবেগে স্খলিত পানি থেকে।","p":591,"j":30,"h":596},{"n":7,"a":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","t":"এটা নির্গত হয় মেরুদন্ড ও বক্ষপাজরের মধ্য থেকে।","p":591,"j":30,"h":596},{"n":8,"a":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","t":"নিশ্চয় তিনি তাকে ফিরিয়ে নিতে সক্ষম।","p":591,"j":30,"h":596},{"n":9,"a":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","t":"যেদিন গোপন বিষয়াদি পরীক্ষিত হবে,","p":591,"j":30,"h":596},{"n":10,"a":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","t":"সেদিন তার কোন শক্তি থাকবে না এবং সাহায্যকারীও থাকবে না।","p":591,"j":30,"h":596},{"n":11,"a":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","t":"শপথ চক্রশীল আকাশের","p":591,"j":30,"h":596},{"n":12,"a":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","t":"এবং বিদারনশীল পৃথিবীর","p":591,"j":30,"h":596},{"n":13,"a":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","t":"নিশ্চয় কোরআন সত্য-মিথ্যার ফয়সালা।","p":591,"j":30,"h":596},{"n":14,"a":"وَمَا هُوَ بِٱلْهَزْلِ","t":"এবং এটা উপহাস নয়।","p":591,"j":30,"h":596},{"n":15,"a":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","t":"তারা ভীষণ চক্রান্ত করে,","p":591,"j":30,"h":596},{"n":16,"a":"وَأَكِيدُ كَيْدًۭا","t":"আর আমিও কৌশল করি।","p":591,"j":30,"h":596},{"n":17,"a":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","t":"অতএব, কাফেরদেরকে অবকাশ দিন, তাদেরকে অবকাশ দিন, কিছু দিনের জন্যে।","p":591,"j":30,"h":596}]