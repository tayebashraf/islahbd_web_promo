[{"n":1,"a":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","t":"প্রত্যেক পশ্চাতে ও সম্মুখে পরনিন্দাকারীর দুর্ভোগ,","p":601,"j":30,"h":607},{"n":2,"a":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","t":"যে অর্থ সঞ্চিত করে ও গণনা করে","p":601,"j":30,"h":607},{"n":3,"a":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","t":"সে মনে করে যে, তার অর্থ চিরকাল তার সাথে থাকবে!","p":601,"j":30,"h":607},{"n":4,"a":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","t":"কখনও না, সে অবশ্যই নিক্ষিপ্ত হবে পিষ্টকারীর মধ্যে।","p":601,"j":30,"h":607},{"n":5,"a":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","t":"আপনি কি জানেন, পিষ্টকারী কি?","p":601,"j":30,"h":607},{"n":6,"a":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","t":"এটা আল্লাহর প্রজ্জ্বলিত অগ্নি,","p":601,"j":30,"h":607},{"n":7,"a":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","t":"যা হৃদয় পর্যন্ত পৌছবে।","p":601,"j":30,"h":607},{"n":8,"a":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","t":"এতে তাদেরকে বেঁধে দেয়া হবে,","p":601,"j":30,"h":607},{"n":9,"a":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","t":"লম্বা লম্বা খুঁটিতে।","p":601,"j":30,"h":607}]